# Local development values only. Do not reuse them outside a local machine.
POSTGRES_DB=esdemo
POSTGRES_USER=esdemo
POSTGRES_PASSWORD=esdemo-dev
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=esdemo
RABBITMQ_DEFAULT_PASS=esdemo-dev
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ASP.NET Core environment-variable overrides for non-development environments:
# ConnectionStrings__Database=Host=localhost;Port=5432;Database=esdemo;Username=esdemo;Password=replace-me
# RabbitMq__Host=localhost
# RabbitMq__Port=5672
# RabbitMq__Username=esdemo
# RabbitMq__Password=replace-me
# RabbitMq__VirtualHost=/
