# Local development only. Copy this file to .env; never commit .env or production credentials.
POSTGRES_DB=esdemo
POSTGRES_USER=esdemo
POSTGRES_PASSWORD=esdemo-dev
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=esdemo
RABBITMQ_DEFAULT_PASS=esdemo-dev
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Backend runtime configuration. Values interpolate the local infrastructure settings above.
ConnectionStrings__Database="Host=localhost;Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
RabbitMq__Host=localhost
RabbitMq__Port=${RABBITMQ_AMQP_PORT}
RabbitMq__Username=${RABBITMQ_DEFAULT_USER}
RabbitMq__Password=${RABBITMQ_DEFAULT_PASS}
RabbitMq__VirtualHost=${RABBITMQ_DEFAULT_VHOST}

# Browser origins allowed to call the API. Add further origins with indexes 1, 2, etc.
Cors__AllowedOrigins__0=http://localhost:3000

# JWT issuer/audience are identifiers. Generate a random Base64 signing key; see docs/authentication.md.
Jwt__Issuer=esdemo-api
Jwt__Audience=esdemo-client
Jwt__SigningKey=
Jwt__AccessTokenMinutes=10
Jwt__RefreshTokenDays=7

# Per-IP auth request limit for a single API instance (includes login/register/refresh/logout/me).
AuthRateLimit__PermitLimit=30
AuthRateLimit__WindowSeconds=60

# Explicit database bootstrap command only. Keep disabled in committed examples.
SeedAdmin__Enabled=false
SeedAdmin__Email=admin@esdemo.local
SeedAdmin__DisplayName="ESDEMO Administrator"
SeedAdmin__Password="replace-with-a-strong-local-password"
