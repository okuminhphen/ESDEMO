# Server-side URL used by Next.js to call the API. Do not prefix with NEXT_PUBLIC_.
API_BASE_URL=http://localhost:5000

# Base64-encoded 32-byte key used only by the Next.js server to encrypt the HttpOnly BFF session cookie.
# Generate with: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
BFF_SESSION_SECRET=
